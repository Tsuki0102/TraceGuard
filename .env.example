# TraceGuard 环境变量配置模板（AUD-04 / OPS-01）
# 复制本文件为 .env 后填入真实值即可（docker compose up 会自动读取根目录 .env）。
# 本文件不含任何真实密钥，仅用于说明变量名与格式。
# 注意：默认未配置 LLM 时，系统大模型能力为「关闭」状态，核心功能（需求-代码一致性校验）不受影响。

# ============ 数据库（MySQL 8.0，docker-compose 的 mysql 容器） ============
# mysql 容器初始化参数
MYSQL_ROOT_PASSWORD=traceguard@2026
MYSQL_APP_USER=traceguard
MYSQL_APP_PASSWORD=traceguard@2026

# backend 连接 MySQL 参数（docker-compose 已在 services.backend.environment 注入，单机运行时可在此覆盖）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=traceguard
MYSQL_USER=traceguard
MYSQL_PASSWORD=traceguard@2026

# ============ 生产必填密钥（SEC-02/03：缺失即拒绝启动，fail-fast） ============
# 请务必替换为高熵随机值，例如 PowerShell 生成：
#   [Convert]::ToBase64String((1..48 | ForEach-Object {Get-Random -Max 256}))
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
# 文件存储加密密钥（上传文件解析结果落盘加密）
STORAGE_ENCRYPT_KEY=change-me-in-production-please-use-a-long-random-secret
# 数据库备份加密密钥（备份文件 .sql.enc 使用）
BACKUP_ENCRYPT_KEY=change-me-in-production-please-use-a-long-random-secret
# LLM 配置加密密钥（系统设置中保存的 API Key 加密存储）
LLM_CONFIG_KEY=change-me-in-production-please-use-a-long-random-secret

# ============ CORS（可选） ============
# 生产跨域白名单（逗号分隔），仅当存在独立域名/端口访问后端时需要；
# 经 nginx 同域反向代理访问（/api/）为同源，无需配置。空值=拒绝跨域携带凭证，本域访问不受影响。
CORS_ALLOWED_ORIGINS=

# ============ 后端服务（可选） ============
# 服务端口（docker-compose 固定映射 8080，单机运行时可改）
SERVER_PORT=8080

# ============ 大模型（LLM）能力（可选，默认关闭） ============
# 是否启用大模型能力：false=关闭（默认，无需任何外部 API 即可运行）；true=开启
LLM_ENABLED=false
# 供应商标识：openai / deepseek / qwen / codellama（本地 CodeLlama，GAP-043）等
LLM_PROVIDER=deepseek
# 大模型服务地址（开启 LLM 时填写）
LLM_BASE_URL=https://api.deepseek.com
# 大模型 API Key（开启 LLM 时填写，切勿提交真实密钥到版本库；本地 Ollama 留空即可）
LLM_API_KEY=sk-your-real-api-key-here
# 可选：具体模型名（不填使用各 provider 默认值）
LLM_MODEL=

# ---- 本地 CodeLlama + LangChain 真集成（GAP-043 / GAP-044，可选） ----
# LLM 增强引擎：self=OpenAI 兼容客户端（默认）；langchain=langchain4j 编排（需依赖可用，失败自动回退 self）
LLM_ENGINE=self
# 本地 Ollama/vLLM 的 OpenAI 兼容端点（默认 http://localhost:11434/v1）
CODELLAMA_BASE_URL=http://localhost:11434/v1
# 本地 CodeLlama 模型名（ollama pull codellama:7b 后即为 codellama:7b）
CODELLAMA_MODEL=codellama:7b

# ---- AI 智能体（Agent，三期扩展） ----
# 定时巡检开关：false=关闭（默认，管理员可在界面手动触发巡检，不受此开关限制）
AGENT_PATROL_ENABLED=false
# 巡检 cron（Spring cron 表达式，默认每日 09:00）
AGENT_PATROL_CRON=0 0 9 * * ?

# ============ 语义向量化（Embedding，默认本地 BGE，开箱即用） ============
# provider：local=本地 BGE ONNX 离线向量化（默认，零外部依赖）；openai=云端 OpenAI 兼容
EMBEDDING_PROVIDER=local
# 本地 BGE 模型文件路径（运行 scripts/download_bge_model.sh 会自动写入本变量）
# 例：./models/bge-small-zh-v1.5/onnx/model.onnx
EMBEDDING_MODEL_PATH=
# 向量维度：bge-small=512（默认），bge-base=768
EMBEDDING_MODEL_DIM=512
# 云端 provider 时使用（可选）
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
