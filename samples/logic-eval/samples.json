[
  {"id": "M01", "file": "Method01.java", "category": "simple-crud", "reference": "创建用户：校验用户名非空，密码不为空则加密存储，调用用户数据访问层插入用户记录并返回新用户标识"},
  {"id": "M02", "file": "Method02.java", "category": "simple-crud", "reference": "删除用户：按用户标识删除用户记录，同时删除该用户的角色关联关系，返回是否删除成功"},
  {"id": "M03", "file": "Method03.java", "category": "simple-crud", "reference": "查询用户：按用户标识从数据访问层查询用户，找不到时返回空值"},
  {"id": "M04", "file": "Method04.java", "category": "simple-crud", "reference": "更新用户：将用户对象的名称与邮箱字段更新到数据库，返回受影响行数"},
  {"id": "M05", "file": "Method05.java", "category": "simple-crud", "reference": "查询全部订单：调用订单数据访问层获取全部订单列表并返回"},
  {"id": "M06", "file": "Method06.java", "category": "simple-crud", "reference": "创建订单：设置订单创建时间为当前时间，初始状态为待支付，插入订单记录并返回订单标识"},
  {"id": "M07", "file": "Method07.java", "category": "simple-crud", "reference": "按编码查询商品：遍历商品列表查找编码匹配的商品，找不到返回空"},
  {"id": "M08", "file": "Method08.java", "category": "simple-crud", "reference": "更新库存：根据商品标识设置新的库存数量，保存到数据访问层"},
  {"id": "M09", "file": "Method09.java", "category": "loop-aggregate", "reference": "遍历订单列表，累计每个订单的金额到总额，金额为负时跳过，最终返回总额"},
  {"id": "M10", "file": "Method10.java", "category": "loop-aggregate", "reference": "遍历用户列表，统计状态为活跃的用户数量，返回计数结果"},
  {"id": "M11", "file": "Method11.java", "category": "loop-aggregate", "reference": "遍历商品价格列表，找出最大值并返回；列表为空时返回零"},
  {"id": "M12", "file": "Method12.java", "category": "loop-aggregate", "reference": "遍历标签列表，用集合去重后收集所有不重复标签并转为列表返回"},
  {"id": "M13", "file": "Method13.java", "category": "loop-aggregate", "reference": "计算成绩平均分：累加全部成绩并除以个数，成绩列表为空时返回零"},
  {"id": "M14", "file": "Method14.java", "category": "loop-aggregate", "reference": "按订单状态分组：遍历订单，将相同状态的订单归入同一列表，返回状态到订单列表的映射"},
  {"id": "M15", "file": "Method15.java", "category": "multi-branch-validation", "reference": "注册校验：用户名为空返回错误码，密码长度小于6返回错误码，邮箱不含@返回错误码，全部通过返回成功"},
  {"id": "M16", "file": "Method16.java", "category": "multi-branch-validation", "reference": "权限校验：角色为管理员或操作者返回通过，否则返回拒绝"},
  {"id": "M17", "file": "Method17.java", "category": "multi-branch-validation", "reference": "交易分类：金额大于一万归为大额，大于一千归为普通，否则归为小额，返回分类名称"},
  {"id": "M18", "file": "Method18.java", "category": "multi-branch-validation", "reference": "计算折扣：会员享受八折，非会员满一百减十，否则原价，返回最终应付金额"},
  {"id": "M19", "file": "Method19.java", "category": "multi-branch-validation", "reference": "校验订单状态：待支付可取消，已发货可签收，其他状态返回非法操作提示"},
  {"id": "M20", "file": "Method20.java", "category": "multi-branch-validation", "reference": "选择配送方式：地址在本地范围使用次日达，否则使用标准快递，返回配送方式名称"},
  {"id": "M21", "file": "Method21.java", "category": "exception-handling", "reference": "解析用户输入：尝试将输入转为整数，格式非法时捕获异常并返回默认值零"},
  {"id": "M22", "file": "Method22.java", "category": "exception-handling", "reference": "读取配置文件：按路径读取文件内容，文件不存在时抛出业务异常提示配置缺失"},
  {"id": "M23", "file": "Method23.java", "category": "exception-handling", "reference": "转账：扣减转出账户余额并增加转入账户余额，余额不足时抛出异常阻止转账"},
  {"id": "M24", "file": "Method24.java", "category": "exception-handling", "reference": "调用远程服务：发送请求获取结果，网络异常时捕获并返回降级默认结果"},
  {"id": "M25", "file": "Method25.java", "category": "resource-management", "reference": "复制文件：使用输入输出流按字节复制，使用完毕后关闭输入与输出流释放资源"},
  {"id": "M26", "file": "Method26.java", "category": "resource-management", "reference": "向输出流写入报表：生成报表文本并写入流，最终关闭流释放资源"},
  {"id": "M27", "file": "Method27.java", "category": "resource-management", "reference": "数据库查询：获取数据库连接执行查询并组装结果，使用完毕后关闭连接释放资源"},
  {"id": "M28", "file": "Method28.java", "category": "state-transition", "reference": "推进订单状态：待支付转为已支付，已支付转为已发货，非法状态直接返回失败"},
  {"id": "M29", "file": "Method29.java", "category": "state-transition", "reference": "支付流程：创建支付记录状态为待处理，支付成功后更新为成功并记录支付时间，失败则标记失败"},
  {"id": "M30", "file": "Method30.java", "category": "state-transition", "reference": "退款流程：校验订单可退款，创建退款单状态为待审核，审核通过后状态转为已退款"}
]
